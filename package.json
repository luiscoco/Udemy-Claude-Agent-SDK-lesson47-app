{
  "name": "claude-agent-sdk-lesson47-opentelemetry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn native SDK telemetry with an actual local OTLP receiver, linked traces, metrics and log events",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "npm start",
    "agent": "npm run sample:env",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test src/agent.test.ts src/startup.test.ts",
    "sample": "tsx src/sample.ts",
    "sample:env": "tsx --env-file-if-exists=.env src/sample.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
